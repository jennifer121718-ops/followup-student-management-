Options -Indexes
DirectoryIndex index.html
<FilesMatch "^(settings\.php|.*\.(sqlite3?|db|zip|key|log|txt))$">
    Require all denied
</FilesMatch>
<IfModule mod_headers.c>
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; frame-ancestors 'none'; base-uri 'none'; form-action 'self'"
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "same-origin"
    Header always set Cache-Control "no-store"
</IfModule>
RewriteEngine On
RewriteRule ^api(?:/.*)?$ api.php [L,QSA]
